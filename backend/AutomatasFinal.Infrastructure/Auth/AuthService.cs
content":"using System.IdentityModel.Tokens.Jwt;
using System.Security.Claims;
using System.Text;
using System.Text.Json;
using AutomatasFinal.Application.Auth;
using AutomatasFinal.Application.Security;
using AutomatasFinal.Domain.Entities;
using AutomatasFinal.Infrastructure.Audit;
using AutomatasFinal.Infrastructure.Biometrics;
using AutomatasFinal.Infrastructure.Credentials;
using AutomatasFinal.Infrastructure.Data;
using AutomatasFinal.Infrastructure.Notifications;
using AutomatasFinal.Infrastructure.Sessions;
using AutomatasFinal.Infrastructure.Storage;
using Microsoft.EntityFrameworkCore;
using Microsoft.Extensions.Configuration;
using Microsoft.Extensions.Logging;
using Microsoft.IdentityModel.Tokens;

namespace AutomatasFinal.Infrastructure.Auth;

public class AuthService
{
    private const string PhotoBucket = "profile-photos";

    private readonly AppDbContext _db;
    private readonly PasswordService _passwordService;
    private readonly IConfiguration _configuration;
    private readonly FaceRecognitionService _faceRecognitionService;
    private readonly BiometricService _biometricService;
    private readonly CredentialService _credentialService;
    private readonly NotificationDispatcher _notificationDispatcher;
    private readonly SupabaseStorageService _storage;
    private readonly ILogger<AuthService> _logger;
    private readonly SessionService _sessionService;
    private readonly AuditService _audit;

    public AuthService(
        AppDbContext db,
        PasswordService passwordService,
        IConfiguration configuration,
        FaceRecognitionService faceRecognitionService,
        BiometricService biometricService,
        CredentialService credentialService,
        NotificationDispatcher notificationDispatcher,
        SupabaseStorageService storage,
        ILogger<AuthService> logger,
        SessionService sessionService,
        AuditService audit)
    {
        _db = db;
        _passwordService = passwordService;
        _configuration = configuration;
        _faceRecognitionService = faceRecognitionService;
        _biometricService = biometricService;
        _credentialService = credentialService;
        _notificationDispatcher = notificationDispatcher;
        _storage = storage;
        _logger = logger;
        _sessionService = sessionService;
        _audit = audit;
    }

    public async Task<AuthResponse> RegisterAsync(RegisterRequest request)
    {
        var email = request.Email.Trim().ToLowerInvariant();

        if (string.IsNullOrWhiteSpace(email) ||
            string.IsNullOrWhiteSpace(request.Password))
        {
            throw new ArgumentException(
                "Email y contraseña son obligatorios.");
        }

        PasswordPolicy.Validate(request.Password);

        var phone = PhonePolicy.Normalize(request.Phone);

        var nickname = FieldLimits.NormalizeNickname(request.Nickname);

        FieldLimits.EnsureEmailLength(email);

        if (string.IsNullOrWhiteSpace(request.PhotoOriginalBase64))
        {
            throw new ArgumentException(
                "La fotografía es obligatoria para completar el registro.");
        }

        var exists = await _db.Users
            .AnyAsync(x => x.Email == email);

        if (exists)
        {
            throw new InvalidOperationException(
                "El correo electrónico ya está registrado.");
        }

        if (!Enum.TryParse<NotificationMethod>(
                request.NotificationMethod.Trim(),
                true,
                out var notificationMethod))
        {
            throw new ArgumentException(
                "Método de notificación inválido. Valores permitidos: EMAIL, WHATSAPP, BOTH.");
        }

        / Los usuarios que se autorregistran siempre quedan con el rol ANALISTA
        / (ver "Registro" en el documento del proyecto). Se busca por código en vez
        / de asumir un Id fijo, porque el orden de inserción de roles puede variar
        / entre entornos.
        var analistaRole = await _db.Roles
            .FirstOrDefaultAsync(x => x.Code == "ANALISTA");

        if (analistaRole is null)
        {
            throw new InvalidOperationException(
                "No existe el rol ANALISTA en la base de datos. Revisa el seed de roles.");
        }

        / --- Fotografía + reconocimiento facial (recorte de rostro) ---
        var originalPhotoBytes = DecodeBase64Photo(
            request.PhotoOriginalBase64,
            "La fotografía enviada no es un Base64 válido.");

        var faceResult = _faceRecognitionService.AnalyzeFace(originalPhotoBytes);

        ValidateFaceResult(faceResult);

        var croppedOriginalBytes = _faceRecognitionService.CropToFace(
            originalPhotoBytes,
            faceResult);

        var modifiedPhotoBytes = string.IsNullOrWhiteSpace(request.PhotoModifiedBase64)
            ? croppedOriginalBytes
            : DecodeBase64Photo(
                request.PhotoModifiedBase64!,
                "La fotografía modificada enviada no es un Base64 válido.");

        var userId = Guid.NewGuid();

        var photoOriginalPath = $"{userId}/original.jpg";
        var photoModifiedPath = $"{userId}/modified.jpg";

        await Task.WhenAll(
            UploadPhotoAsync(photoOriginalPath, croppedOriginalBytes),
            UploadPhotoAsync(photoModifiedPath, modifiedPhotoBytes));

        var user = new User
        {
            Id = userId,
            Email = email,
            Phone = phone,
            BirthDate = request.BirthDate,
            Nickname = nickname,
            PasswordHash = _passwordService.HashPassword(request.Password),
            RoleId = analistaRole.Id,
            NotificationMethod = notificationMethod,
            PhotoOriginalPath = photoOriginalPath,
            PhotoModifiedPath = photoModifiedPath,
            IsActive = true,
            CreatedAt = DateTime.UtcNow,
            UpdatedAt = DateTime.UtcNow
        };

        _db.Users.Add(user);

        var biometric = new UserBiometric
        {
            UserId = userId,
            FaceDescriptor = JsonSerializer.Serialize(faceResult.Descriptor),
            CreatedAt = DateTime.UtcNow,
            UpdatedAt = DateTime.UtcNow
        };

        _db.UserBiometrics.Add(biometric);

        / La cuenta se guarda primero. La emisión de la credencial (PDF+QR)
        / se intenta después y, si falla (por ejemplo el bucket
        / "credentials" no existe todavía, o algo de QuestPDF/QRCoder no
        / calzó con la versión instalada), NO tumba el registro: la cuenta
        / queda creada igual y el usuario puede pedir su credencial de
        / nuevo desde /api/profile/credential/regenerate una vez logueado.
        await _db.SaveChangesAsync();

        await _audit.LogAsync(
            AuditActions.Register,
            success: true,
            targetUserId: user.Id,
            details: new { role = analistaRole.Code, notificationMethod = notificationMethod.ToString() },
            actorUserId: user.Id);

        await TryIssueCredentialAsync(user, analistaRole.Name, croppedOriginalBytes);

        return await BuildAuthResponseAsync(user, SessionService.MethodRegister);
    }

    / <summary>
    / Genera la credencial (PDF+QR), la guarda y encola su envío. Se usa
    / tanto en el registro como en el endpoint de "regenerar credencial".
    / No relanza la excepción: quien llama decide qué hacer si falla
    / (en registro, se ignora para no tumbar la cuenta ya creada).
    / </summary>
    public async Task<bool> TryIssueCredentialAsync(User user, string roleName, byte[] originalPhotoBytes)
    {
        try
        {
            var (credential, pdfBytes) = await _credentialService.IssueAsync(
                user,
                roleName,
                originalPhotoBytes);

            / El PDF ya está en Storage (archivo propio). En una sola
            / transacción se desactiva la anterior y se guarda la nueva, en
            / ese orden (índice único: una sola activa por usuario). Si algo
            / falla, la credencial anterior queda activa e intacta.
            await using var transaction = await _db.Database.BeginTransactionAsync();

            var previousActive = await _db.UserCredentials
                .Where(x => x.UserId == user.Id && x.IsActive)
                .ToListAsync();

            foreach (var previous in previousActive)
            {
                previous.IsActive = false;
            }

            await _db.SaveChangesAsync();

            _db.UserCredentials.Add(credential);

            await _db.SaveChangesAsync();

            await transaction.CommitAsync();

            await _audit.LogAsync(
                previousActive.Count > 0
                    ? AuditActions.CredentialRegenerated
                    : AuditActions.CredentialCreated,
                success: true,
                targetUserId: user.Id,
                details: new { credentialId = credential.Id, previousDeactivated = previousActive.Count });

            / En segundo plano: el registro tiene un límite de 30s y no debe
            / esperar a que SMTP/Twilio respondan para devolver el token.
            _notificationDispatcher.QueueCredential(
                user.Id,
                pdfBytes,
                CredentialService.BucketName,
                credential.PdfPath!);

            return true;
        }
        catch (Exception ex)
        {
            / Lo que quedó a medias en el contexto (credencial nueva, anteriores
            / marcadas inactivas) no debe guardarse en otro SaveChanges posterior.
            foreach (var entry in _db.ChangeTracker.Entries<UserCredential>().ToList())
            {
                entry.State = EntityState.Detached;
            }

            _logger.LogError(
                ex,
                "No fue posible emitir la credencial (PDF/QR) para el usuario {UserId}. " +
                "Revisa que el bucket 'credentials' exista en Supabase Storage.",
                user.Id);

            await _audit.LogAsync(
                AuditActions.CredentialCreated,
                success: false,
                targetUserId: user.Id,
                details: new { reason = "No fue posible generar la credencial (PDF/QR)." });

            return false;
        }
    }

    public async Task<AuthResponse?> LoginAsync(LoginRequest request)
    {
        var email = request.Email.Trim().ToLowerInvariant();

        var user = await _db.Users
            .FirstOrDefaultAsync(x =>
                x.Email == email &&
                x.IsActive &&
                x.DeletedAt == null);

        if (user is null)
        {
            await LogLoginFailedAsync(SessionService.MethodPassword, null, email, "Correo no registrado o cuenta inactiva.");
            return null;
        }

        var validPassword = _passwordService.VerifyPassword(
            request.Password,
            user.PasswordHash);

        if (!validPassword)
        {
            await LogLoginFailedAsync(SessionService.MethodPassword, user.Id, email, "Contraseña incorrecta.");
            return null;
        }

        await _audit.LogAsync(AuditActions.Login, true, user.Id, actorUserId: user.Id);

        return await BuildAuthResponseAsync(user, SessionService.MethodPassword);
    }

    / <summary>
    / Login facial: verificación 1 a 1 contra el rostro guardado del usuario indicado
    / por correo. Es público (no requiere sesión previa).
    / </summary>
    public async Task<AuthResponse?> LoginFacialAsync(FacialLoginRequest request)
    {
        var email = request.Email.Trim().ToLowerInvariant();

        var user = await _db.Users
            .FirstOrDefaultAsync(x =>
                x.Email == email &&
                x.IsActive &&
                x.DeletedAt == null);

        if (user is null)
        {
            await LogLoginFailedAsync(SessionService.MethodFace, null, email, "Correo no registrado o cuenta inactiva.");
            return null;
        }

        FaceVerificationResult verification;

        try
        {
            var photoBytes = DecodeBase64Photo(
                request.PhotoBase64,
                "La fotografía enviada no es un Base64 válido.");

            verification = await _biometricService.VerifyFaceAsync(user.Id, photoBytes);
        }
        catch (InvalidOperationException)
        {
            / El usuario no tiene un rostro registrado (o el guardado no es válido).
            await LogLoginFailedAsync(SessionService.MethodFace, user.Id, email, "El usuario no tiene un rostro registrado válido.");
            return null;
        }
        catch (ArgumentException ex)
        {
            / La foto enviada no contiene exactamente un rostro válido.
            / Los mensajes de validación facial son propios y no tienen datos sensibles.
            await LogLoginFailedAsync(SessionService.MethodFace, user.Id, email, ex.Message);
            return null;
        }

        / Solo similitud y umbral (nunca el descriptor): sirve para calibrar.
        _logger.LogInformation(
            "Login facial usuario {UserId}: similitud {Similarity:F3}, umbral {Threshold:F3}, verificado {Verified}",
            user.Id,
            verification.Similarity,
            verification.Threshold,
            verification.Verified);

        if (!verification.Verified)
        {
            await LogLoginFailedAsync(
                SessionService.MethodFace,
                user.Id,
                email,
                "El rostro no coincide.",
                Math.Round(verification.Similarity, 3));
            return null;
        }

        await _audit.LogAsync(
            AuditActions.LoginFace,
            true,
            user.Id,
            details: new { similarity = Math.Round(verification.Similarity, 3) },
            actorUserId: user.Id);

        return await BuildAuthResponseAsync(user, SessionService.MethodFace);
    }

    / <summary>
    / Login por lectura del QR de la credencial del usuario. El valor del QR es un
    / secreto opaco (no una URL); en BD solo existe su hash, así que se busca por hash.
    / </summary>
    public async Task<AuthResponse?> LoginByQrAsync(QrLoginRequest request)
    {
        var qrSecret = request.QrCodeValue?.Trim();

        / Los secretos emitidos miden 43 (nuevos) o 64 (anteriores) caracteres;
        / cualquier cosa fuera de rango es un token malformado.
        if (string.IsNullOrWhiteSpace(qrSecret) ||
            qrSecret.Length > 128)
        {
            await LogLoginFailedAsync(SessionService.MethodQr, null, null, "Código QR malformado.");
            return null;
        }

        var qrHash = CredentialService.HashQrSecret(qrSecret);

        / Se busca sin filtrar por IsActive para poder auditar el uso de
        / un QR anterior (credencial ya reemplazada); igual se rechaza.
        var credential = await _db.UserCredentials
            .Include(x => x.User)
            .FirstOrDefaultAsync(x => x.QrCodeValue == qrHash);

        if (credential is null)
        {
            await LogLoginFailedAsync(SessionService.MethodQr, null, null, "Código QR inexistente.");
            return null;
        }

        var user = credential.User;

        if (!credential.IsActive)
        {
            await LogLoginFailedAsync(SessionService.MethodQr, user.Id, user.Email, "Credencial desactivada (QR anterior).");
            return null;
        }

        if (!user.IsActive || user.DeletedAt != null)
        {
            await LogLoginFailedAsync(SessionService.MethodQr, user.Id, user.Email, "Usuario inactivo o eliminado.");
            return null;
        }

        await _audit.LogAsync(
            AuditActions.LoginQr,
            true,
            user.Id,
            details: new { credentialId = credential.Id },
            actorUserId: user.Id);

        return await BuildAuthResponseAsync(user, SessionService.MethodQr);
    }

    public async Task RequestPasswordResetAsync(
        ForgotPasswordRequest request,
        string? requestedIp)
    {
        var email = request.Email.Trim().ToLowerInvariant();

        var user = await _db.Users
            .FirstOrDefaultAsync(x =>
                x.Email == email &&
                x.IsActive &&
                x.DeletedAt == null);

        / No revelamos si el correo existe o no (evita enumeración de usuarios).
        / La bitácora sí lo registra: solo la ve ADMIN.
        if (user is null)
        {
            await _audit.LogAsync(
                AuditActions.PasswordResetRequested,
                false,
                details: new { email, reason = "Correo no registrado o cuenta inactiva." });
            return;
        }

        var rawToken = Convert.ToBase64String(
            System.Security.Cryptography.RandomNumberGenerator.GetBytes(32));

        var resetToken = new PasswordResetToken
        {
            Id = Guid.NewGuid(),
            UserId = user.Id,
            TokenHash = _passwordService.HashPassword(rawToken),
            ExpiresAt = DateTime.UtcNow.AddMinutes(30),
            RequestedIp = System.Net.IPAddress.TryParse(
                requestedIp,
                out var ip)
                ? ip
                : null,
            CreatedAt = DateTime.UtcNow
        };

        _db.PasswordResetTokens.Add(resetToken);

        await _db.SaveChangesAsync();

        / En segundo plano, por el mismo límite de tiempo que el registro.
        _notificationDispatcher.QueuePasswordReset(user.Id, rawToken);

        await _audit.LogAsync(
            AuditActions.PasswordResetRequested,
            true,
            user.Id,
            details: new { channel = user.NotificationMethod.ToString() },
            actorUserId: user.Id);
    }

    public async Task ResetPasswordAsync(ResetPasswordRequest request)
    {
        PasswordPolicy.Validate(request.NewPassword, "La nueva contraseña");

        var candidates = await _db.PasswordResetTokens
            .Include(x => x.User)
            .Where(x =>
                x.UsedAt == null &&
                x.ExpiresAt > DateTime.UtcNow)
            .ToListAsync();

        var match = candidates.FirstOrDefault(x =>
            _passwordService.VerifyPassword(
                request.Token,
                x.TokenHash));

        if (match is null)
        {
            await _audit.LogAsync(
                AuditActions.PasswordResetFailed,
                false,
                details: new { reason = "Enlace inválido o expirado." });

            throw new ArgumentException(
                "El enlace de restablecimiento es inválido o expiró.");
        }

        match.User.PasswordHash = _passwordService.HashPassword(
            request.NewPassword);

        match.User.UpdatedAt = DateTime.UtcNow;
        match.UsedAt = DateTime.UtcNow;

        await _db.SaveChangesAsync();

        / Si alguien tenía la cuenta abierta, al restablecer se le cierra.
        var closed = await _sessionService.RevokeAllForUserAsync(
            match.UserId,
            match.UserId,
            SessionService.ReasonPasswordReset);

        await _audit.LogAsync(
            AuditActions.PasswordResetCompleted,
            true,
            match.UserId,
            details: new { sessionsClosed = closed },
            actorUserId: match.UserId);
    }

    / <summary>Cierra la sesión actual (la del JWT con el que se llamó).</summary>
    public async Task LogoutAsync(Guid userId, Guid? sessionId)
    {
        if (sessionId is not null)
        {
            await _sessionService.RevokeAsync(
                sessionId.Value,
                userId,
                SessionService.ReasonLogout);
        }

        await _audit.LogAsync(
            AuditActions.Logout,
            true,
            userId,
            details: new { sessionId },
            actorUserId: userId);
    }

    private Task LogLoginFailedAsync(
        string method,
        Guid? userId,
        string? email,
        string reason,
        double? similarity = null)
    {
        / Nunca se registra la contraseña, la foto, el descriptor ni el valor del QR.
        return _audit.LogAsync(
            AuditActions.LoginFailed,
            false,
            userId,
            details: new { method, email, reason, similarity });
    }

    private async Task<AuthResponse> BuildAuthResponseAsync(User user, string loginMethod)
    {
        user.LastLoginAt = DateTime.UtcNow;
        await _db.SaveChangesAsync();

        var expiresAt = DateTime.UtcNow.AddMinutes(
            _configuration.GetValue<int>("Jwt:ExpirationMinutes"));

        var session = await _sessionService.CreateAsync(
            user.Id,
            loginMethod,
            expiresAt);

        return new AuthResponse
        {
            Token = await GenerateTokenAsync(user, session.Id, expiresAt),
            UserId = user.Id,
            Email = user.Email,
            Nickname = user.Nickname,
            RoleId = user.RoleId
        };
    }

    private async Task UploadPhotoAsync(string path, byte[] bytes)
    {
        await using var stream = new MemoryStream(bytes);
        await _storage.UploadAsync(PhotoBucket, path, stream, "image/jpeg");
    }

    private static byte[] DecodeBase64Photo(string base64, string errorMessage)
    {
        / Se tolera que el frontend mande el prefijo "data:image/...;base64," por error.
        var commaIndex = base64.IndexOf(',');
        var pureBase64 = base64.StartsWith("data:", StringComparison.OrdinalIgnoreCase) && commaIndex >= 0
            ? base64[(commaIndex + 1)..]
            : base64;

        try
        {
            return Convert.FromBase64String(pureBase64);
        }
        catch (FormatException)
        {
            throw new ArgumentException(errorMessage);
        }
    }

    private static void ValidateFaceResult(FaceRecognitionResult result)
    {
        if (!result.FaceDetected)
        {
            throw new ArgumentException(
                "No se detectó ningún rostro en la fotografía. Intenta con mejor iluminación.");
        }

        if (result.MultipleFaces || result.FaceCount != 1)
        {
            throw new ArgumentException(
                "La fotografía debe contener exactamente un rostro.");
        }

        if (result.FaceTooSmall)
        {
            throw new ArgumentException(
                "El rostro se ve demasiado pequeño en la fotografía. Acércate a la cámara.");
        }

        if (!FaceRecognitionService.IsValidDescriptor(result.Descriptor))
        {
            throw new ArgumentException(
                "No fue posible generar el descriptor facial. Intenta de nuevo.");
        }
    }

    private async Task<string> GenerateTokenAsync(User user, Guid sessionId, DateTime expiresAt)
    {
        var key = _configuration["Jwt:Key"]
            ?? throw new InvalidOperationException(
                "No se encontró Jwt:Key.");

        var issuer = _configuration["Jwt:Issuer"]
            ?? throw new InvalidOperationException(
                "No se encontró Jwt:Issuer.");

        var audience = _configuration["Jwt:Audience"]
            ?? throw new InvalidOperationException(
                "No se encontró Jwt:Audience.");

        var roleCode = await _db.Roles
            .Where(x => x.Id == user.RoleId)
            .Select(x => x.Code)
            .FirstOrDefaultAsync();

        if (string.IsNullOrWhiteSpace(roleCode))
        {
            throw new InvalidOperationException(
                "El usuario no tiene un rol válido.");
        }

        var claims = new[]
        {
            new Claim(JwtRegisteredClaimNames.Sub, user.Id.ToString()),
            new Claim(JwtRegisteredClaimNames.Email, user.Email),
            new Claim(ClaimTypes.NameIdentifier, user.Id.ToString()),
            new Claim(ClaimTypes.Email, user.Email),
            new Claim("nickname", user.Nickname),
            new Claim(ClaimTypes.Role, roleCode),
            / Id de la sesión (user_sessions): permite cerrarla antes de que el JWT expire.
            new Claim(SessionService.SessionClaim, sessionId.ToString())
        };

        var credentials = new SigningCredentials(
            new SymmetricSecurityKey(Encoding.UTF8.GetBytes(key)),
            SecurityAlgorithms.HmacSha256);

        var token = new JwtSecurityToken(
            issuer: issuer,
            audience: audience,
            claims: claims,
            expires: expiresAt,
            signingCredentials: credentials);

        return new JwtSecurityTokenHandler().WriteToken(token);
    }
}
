using AutomatasFinal.Application.Security;
using AutomatasFinal.Application.Users;
using AutomatasFinal.Domain.Entities;
using AutomatasFinal.Infrastructure.Audit;
using AutomatasFinal.Infrastructure.Auth;
using AutomatasFinal.Infrastructure.Credentials;
using AutomatasFinal.Infrastructure.Data;
using AutomatasFinal.Infrastructure.Notifications;
using AutomatasFinal.Infrastructure.Sessions;
using AutomatasFinal.Infrastructure.Storage;
using Microsoft.AspNetCore.Http;
using Microsoft.EntityFrameworkCore;

namespace AutomatasFinal.Infrastructure.Users;

public class ProfileService
{
    private const string PhotoBucket = "profile-photos";

    private readonly NotificationDispatcher _notificationDispatcher;
    private readonly CredentialService _credentialService;
    private readonly AppDbContext _db;
    private readonly PasswordService _passwordService;
    private readonly SupabaseStorageService _storage;
    private readonly AuthService _authService;
    private readonly SessionService _sessionService;
    private readonly AuditService _audit;
    private readonly IHttpContextAccessor _httpContextAccessor;
    private readonly AutomatasFinal.Infrastructure.Biometrics.FaceRecognitionService _faceRecognitionService;

    public ProfileService(
        AppDbContext db,
        PasswordService passwordService,
        SupabaseStorageService storage,
        AuthService authService,
        CredentialService credentialService,
        NotificationDispatcher notificationDispatcher,
        SessionService sessionService,
        AuditService audit,
        IHttpContextAccessor httpContextAccessor,
        AutomatasFinal.Infrastructure.Biometrics.FaceRecognitionService faceRecognitionService)
    {
        _faceRecognitionService = faceRecognitionService;
        _db = db;
        _passwordService = passwordService;
        _storage = storage;
        _authService = authService;
        _credentialService = credentialService;
        _notificationDispatcher = notificationDispatcher;
        _sessionService = sessionService;
        _audit = audit;
        _httpContextAccessor = httpContextAccessor;
    }

    public async Task<User?> GetMyProfileAsync(Guid userId)
    {
        return await _db.Users
            .AsNoTracking()
            .Include(x => x.Role)
            .FirstOrDefaultAsync(x =>
                x.Id == userId &&
                x.DeletedAt == null);
    }

    public async Task<bool> UpdateMyProfileAsync(
        Guid userId,
        UpdateProfileRequest request)
    {
        var user = await _db.Users
            .FirstOrDefaultAsync(x =>
                x.Id == userId &&
                x.DeletedAt == null);

        if (user is null)
        {
            return false;
        }

        var nickname = FieldLimits.NormalizeNickname(request.Nickname);

        var phone = PhonePolicy.Normalize(request.Phone);

        if (!Enum.TryParse<NotificationMethod>(
                request.NotificationMethod.Trim(),
                true,
                out var notificationMethod))
        {
            throw new ArgumentException(
                "Método de notificación inválido. Valores permitidos: EMAIL, WHATSAPP, BOTH.");
        }

        var nicknameExists = await _db.Users
            .AnyAsync(x =>
                x.Nickname == nickname &&
                x.Id != userId);

        if (nicknameExists)
        {
            throw new InvalidOperationException(
                "El nickname ya está en uso.");
        }

        var changes = new List<object>();

        AddChange(changes, "nickname", user.Nickname, nickname);
        AddChange(changes, "phone", user.Phone, phone);
        AddChange(changes, "notificationMethod", user.NotificationMethod.ToString(), notificationMethod.ToString());

        user.Nickname = nickname;
        user.Phone = phone;
        user.NotificationMethod = notificationMethod;
        user.UpdatedAt = DateTime.UtcNow;

        await _db.SaveChangesAsync();

        await _audit.LogAsync(
            AuditActions.ProfileUpdated,
            true,
            user.Id,
            details: new { changes });

        return true;
    }

    public async Task<bool> ChangeMyPasswordAsync(
        Guid userId,
        ChangePasswordRequest request)
    {
        var user = await _db.Users
            .FirstOrDefaultAsync(x =>
                x.Id == userId &&
                x.DeletedAt == null);

        if (user is null)
        {
            return false;
        }

        if (!_passwordService.VerifyPassword(
                request.CurrentPassword,
                user.PasswordHash))
        {
            await _audit.LogAsync(
                AuditActions.PasswordChangeFailed,
                false,
                user.Id,
                details: new { reason = "Contraseña actual incorrecta." });

            throw new ArgumentException(
                "La contraseña actual no es correcta.");
        }

        PasswordPolicy.Validate(request.NewPassword, "La nueva contraseña");

        user.PasswordHash = _passwordService.HashPassword(
            request.NewPassword);

        user.UpdatedAt = DateTime.UtcNow;

        await _db.SaveChangesAsync();

        // Se cierran las demás sesiones; la actual (desde donde la cambió) sigue.
        var closed = await _sessionService.RevokeAllForUserAsync(
            user.Id,
            user.Id,
            SessionService.ReasonPasswordChanged,
            SessionService.GetSessionId(_httpContextAccessor.HttpContext?.User));

        await _audit.LogAsync(
            AuditActions.PasswordChanged,
            true,
            user.Id,
            details: new { otherSessionsClosed = closed });

        return true;
    }

    /// <summary>
    /// Cambia la foto del perfil. Recibe la foto original (sin editar) y la
    /// modificada (con recorte, filtros y stickers, para barra de estado y
    /// credencial). La original debe tener exactamente un rostro y se recorta
    /// al rostro, igual que en el registro. Ambas van a Storage (bucket
    /// privado). El descriptor biométrico NO se toca: el login facial se
    /// gestiona aparte, así decorar la foto no puede romperlo.
    /// </summary>
    public async Task<string?> UpdateMyPhotoAsync(
        Guid userId,
        byte[] originalBytes,
        byte[]? modifiedBytes)
    {
        var user = await _db.Users
            .FirstOrDefaultAsync(x =>
                x.Id == userId &&
                x.DeletedAt == null);

        if (user is null)
        {
            return null;
        }

        var face = _faceRecognitionService.AnalyzeFace(originalBytes);

        if (!face.FaceDetected)
        {
            throw new ArgumentException(
                "No se detectó ningún rostro en la foto original. Intenta con mejor iluminación.");
        }

        if (face.MultipleFaces || face.FaceCount != 1)
        {
            throw new ArgumentException(
                "La foto debe contener exactamente un rostro.");
        }

        if (face.FaceTooSmall)
        {
            throw new ArgumentException(
                "El rostro se ve demasiado pequeño. Acércate a la cámara.");
        }

        var croppedOriginal = _faceRecognitionService.CropToFace(originalBytes, face);

        // La modificada se decodifica y se vuelve a codificar: si no es una
        // imagen válida se rechaza, y se descartan metadatos.
        byte[] modified = croppedOriginal;

        if (modifiedBytes is { Length: > 0 })
        {
            using var image = OpenCvSharp.Cv2.ImDecode(modifiedBytes, OpenCvSharp.ImreadModes.Color);

            if (image.Empty())
            {
                throw new ArgumentException("La foto editada no es una imagen válida.");
            }

            OpenCvSharp.Cv2.ImEncode(".jpg", image, out modified);
        }

        var originalPath = $"{userId}/original.jpg";
        var modifiedPath = $"{userId}/modified.jpg";

        await using (var stream = new MemoryStream(croppedOriginal))
        {
            await _storage.UploadAsync(PhotoBucket, originalPath, stream, "image/jpeg");
        }

        await using (var stream = new MemoryStream(modified))
        {
            await _storage.UploadAsync(PhotoBucket, modifiedPath, stream, "image/jpeg");
        }

        user.PhotoOriginalPath = originalPath;
        user.PhotoModifiedPath = modifiedPath;
        user.UpdatedAt = DateTime.UtcNow;

        await _db.SaveChangesAsync();

        await _audit.LogAsync(
            AuditActions.PhotoUpdated,
            true,
            user.Id,
            details: new { edited = modifiedBytes is { Length: > 0 } });

        return modifiedPath;
    }

    public async Task<(byte[] Bytes, string ContentType)?> GetMyPhotoAsync(
        Guid userId,
        bool modified)
    {
        var user = await _db.Users
            .AsNoTracking()
            .FirstOrDefaultAsync(x =>
                x.Id == userId &&
                x.DeletedAt == null);

        var path = modified
            ? user?.PhotoModifiedPath
            : user?.PhotoOriginalPath;

        if (user is null || string.IsNullOrWhiteSpace(path))
        {
            return null;
        }

        var bytes = await _storage.DownloadAsync(
            PhotoBucket,
            path);

        var contentType = path.EndsWith(
            ".png",
            StringComparison.OrdinalIgnoreCase)
            ? "image/png"
            : "image/jpeg";

        return (bytes, contentType);
    }

    /// <summary>
    /// PDF de la credencial ACTIVA del usuario, leído desde Storage (bucket
    /// privado). Solo lectura: no genera ni modifica credenciales.
    /// Devuelve null si el usuario no tiene credencial activa.
    /// </summary>
    public async Task<byte[]?> GetMyActiveCredentialPdfAsync(Guid userId)
    {
        var pdfPath = await _db.UserCredentials
            .AsNoTracking()
            .Where(x =>
                x.UserId == userId &&
                x.IsActive &&
                x.User.DeletedAt == null &&
                x.PdfPath != null)
            .Select(x => x.PdfPath)
            .FirstOrDefaultAsync();

        if (string.IsNullOrWhiteSpace(pdfPath))
        {
            return null;
        }

        return await _storage.DownloadAsync(
            CredentialService.BucketName,
            pdfPath);
    }

    /// <summary>
    /// Fecha de emisión de la credencial activa (null si no tiene).
    /// </summary>
    public async Task<DateTime?> GetMyActiveCredentialIssuedAtAsync(Guid userId)
    {
        return await _db.UserCredentials
            .AsNoTracking()
            .Where(x => x.UserId == userId && x.IsActive)
            .Select(x => (DateTime?)x.IssuedAt)
            .FirstOrDefaultAsync();
    }

    /// <summary>
    /// PDF de vista previa con un diseño sin guardar. Identidad real del
    /// usuario, QR de muestra. No crea ni guarda nada.
    /// </summary>
    public async Task<byte[]?> RenderCredentialPreviewAsync(
        Guid userId,
        AutomatasFinal.Application.Credentials.CredentialDesignDto design)
    {
        var user = await _db.Users
            .AsNoTracking()
            .Include(x => x.Role)
            .FirstOrDefaultAsync(x =>
                x.Id == userId &&
                x.IsActive &&
                x.DeletedAt == null);

        if (user is null || string.IsNullOrWhiteSpace(user.PhotoOriginalPath))
        {
            return null;
        }

        var photo = await _storage.DownloadAsync(PhotoBucket, user.PhotoOriginalPath);

        return await _credentialService.RenderPreviewAsync(
            user,
            user.Role.Name,
            photo,
            design);
    }

    /// <summary>
    /// Crea o regenera la credencial (única forma de hacerlo). La anterior
    /// queda inactiva y su QR deja de servir. Devuelve un mensaje de error
    /// apto para el usuario, o null si salió bien.
    /// </summary>
    public async Task<string?> RegenerateCredentialAsync(Guid userId)
    {
        var user = await _db.Users
            .Include(x => x.Role)
            .FirstOrDefaultAsync(x =>
                x.Id == userId &&
                x.IsActive &&
                x.DeletedAt == null);

        if (user is null)
        {
            return "Usuario no válido.";
        }

        if (string.IsNullOrWhiteSpace(user.PhotoOriginalPath))
        {
            return "Necesitas una fotografía de perfil para generar tu credencial.";
        }

        var originalPhotoBytes = await _storage.DownloadAsync(PhotoBucket, user.PhotoOriginalPath);

        var ok = await _authService.TryIssueCredentialAsync(user, user.Role.Name, originalPhotoBytes);

        return ok
            ? null
            : "No fue posible generar la credencial. Intenta de nuevo en unos minutos.";
    }

    private static void AddChange(
        List<object> changes,
        string field,
        string? from,
        string? to)
    {
        if (!string.Equals(from, to, StringComparison.Ordinal))
        {
            changes.Add(new { field, from, to });
        }
    }
}
