# Copia este archivo como .env y llena los valores reales.
# .env está en .gitignore: NUNCA lo subas a GitHub ni lo metas en un zip compartido.
# Lo usa docker-compose.yml. Para correr con iniciar.sh / iniciar-todo.bat,
# el backend lee los mismos valores desde user-secrets (dotnet user-secrets).

# --- Base de datos (Supabase PostgreSQL) ---
DB_CONNECTION_STRING=

# --- JWT (mínimo 32 caracteres aleatorios) ---
JWT_KEY=

# --- Supabase Storage ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- URL pública del frontend (la del QR de la credencial) ---
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_API_URL=http://localhost:8080/api
# Dominios extra del frontend permitidos por CORS (separados por coma), p. ej. https://tu-app.vercel.app
CORS_ALLOWED_ORIGINS=

# --- SMTP (correo) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AutomatasFinal

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- reCAPTCHA ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# --- Servicio NLP (spaCy/Stanza, carpeta nlp-service) ---
# Local: http://localhost:8000 . En Render: la URL del servicio. Vacío = valor por defecto.
NLP_SERVICE_URL=
